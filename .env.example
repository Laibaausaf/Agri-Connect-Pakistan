DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-secret-min-32-chars"
DEMO_MODE="true"
# AgriConnect AI assistant (farmer chat). Any OpenAI-compatible /chat/completions
# provider works: set the key, base URL and model for that provider.
# Get an OpenRouter key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Low-cost model with structured outputs (json_schema) and good Urdu / Roman Urdu
OPENROUTER_MODEL="qwen/qwen-plus"
