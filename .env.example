DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="change-me-to-a-random-secret-min-32-chars"
# AgriConnect AI assistant. Any OpenAI-compatible /chat/completions
# provider works. Defaults: Alibaba Cloud Model Studio, Singapore region.
# Create a Singapore API key in the Model Studio console.
AI_API_KEY=""
AI_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
# Workspace-dedicated domain (recommended by Alibaba for production; the key
# must belong to that workspace):
# AI_BASE_URL="https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
AI_MODEL="qwen-plus-2025-12-01"
# Optional: model for the arhti, vendor and shopkeeper assistants (e.g. another
# qwen-plus snapshot with its own free quota). Falls back to AI_MODEL when unset.
# AI_MODEL_TRADER="qwen-plus-2025-07-14"
