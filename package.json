{
  "name": "agriconnect",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-rules.ts",
    "db:generate": "prisma generate",
